OWNER_LOGIN_USERNAME=owner
OWNER_LOGIN_PASSWORD=change_me_owner_password
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Required runtime env
PULSE_API_BASE_URL=http://localhost:3101
DEXCOM_GATEWAY_BASE_URL=http://localhost:3101
ADMIN_BEARER_TOKEN=replace_with_api_admin_bearer_token

# Optional overrides
DEXCOM_GATEWAY_ADMIN_TOKEN=replace_with_gateway_admin_bearer_token
PULSE_API_STATUS_TOKEN=optional_existing_status_page_token
PULSE_API_CONSUMER_KEY=replace_with_consumer_api_key

# Notes:
# 1. Do not set PULSE_API_ADMIN_TOKEN or PULSE_API_TARGET. They are obsolete in VenoDashboard.
# 2. PULSE_API_CONSUMER_KEY is optional. If it is omitted, VenoDashboard falls back to ADMIN_BEARER_TOKEN.
# 3. DEXCOM_GATEWAY_ADMIN_TOKEN is optional. If it is omitted, VenoDashboard falls back to ADMIN_BEARER_TOKEN.
# 4. A simple local workflow is: keep prod values first, then add a second local override block below.
# 5. In .env.local, the last duplicate key wins. Comment out the local override block to switch back to prod.
#
# Example local override block:
# PULSE_API_BASE_URL=http://127.0.0.1:3101
# DEXCOM_GATEWAY_BASE_URL=http://127.0.0.1:3101
# ADMIN_BEARER_TOKEN=replace_with_local_api_admin_bearer_token
# DEXCOM_GATEWAY_ADMIN_TOKEN=
# PULSE_API_STATUS_TOKEN=
# PULSE_API_CONSUMER_KEY=
