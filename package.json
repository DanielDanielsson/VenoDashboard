{
  "name": "veno-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:css": "node scripts/generate-component-imports.mjs",
    "gen:component": "node scripts/generate-component.mjs",
    "predev": "npm run gen:css",
    "dev": "next dev -p 3001",
    "prebuild": "npm run gen:css && node scripts/refresh-contract-snapshots.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "ci:local": "bash scripts/run-local-ci.sh"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "16.1.6",
    "openapi-types": "^12.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
